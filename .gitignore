# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# backups do .env (o refresh de token cria .env.bak-<timestamp> com credenciais)
.env.bak-*
.env.backup-*
# despejo de layers gravado pelo normalizar-peso-fontes.ts (megabytes de JSON)
backup-peso-fontes-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db
prisma/*.db-journal
prisma/generated/

# clerk configuration (can include secrets)
/.clerk/

# Replicate test app (contains sensitive tokens in history)
my-replicate-app/

# Internal prompts and docs (may contain sensitive info)
# Only ignore the root-level prompts/ directory, not src/app/(protected)/prompts/
/prompts/

# Saída dos scripts de paridade A/B (PNGs de inspeção)
scripts/.tmp-parity-out/

# Saída do medidor de resolução (JPEGs pesados, nunca versionados)
.tmp-medicao-*/
.tmp-modelo-vs-modelo/
.tmp-modelo-a-seguir/
.tmp-qualidade-arte*/
.tmp-edicao-foto/
.tmp-medicao*/

# Canvas de design (design-canvas/): só código, artboards, json e relatórios
# vão para o git. Fotos originais, previews, renders e amostras ficam fora —
# eram 3,5 GB em 01/09/2026. O render se refaz a partir do artboard.
design-canvas/**/fotos/
design-canvas/**/fotos-story/
design-canvas/**/img/
design-canvas/**/img-story/
design-canvas/**/render/
design-canvas/**/render-*/
design-canvas/**/amostra/
design-canvas/**/originais/
design-canvas/**/orig/
design-canvas/**/saida/
design-canvas/**/refs/
design-canvas/**/entrega/
design-canvas/**/entrega-stories/
design-canvas/**/agendar/
design-canvas/**/prints/
design-canvas/**/prev/
design-canvas/**/pool/
design-canvas/**/packshots/
design-canvas/**/upload/
design-canvas/**/curadoria/
design-canvas/**/extraido-*/
design-canvas/**/*.png
design-canvas/**/*.jpg
design-canvas/**/*.jpeg
design-canvas/**/*.bak
# O bundle do canvas publicado (<leva>.html, 3-10 MB, imagens em base64) se
# resemeia pelo /design a partir dos artboards; só os .dc.html são fonte.
design-canvas/**/*.html
!design-canvas/**/*.dc.html
