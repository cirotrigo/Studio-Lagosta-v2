/// Avaliações do Google Meu Negócio, coletadas via Windsor.ai (30/08/2026).
/// Segue o precedente da InstagramFeed: relação com Project (dono estrito),
/// chave natural única (`reviewId`), coleta que só atualiza — nunca zera.
/// `respostaSugerida` é o rascunho gerado por IA para a EQUIPE editar e
/// enviar; `avisadaEm` é a trava do aviso de negativa no WhatsApp (uma vez).
model AvaliacaoGoogle {
  id               String    @id @default(cuid())
  projectId        Int
  locationId       String
  reviewId         String    @unique
  autor            String?
  estrelas         Int
  texto            String?
  criadaEm         DateTime
  atualizadaEm     DateTime?
  textoResposta    String?
  respondidaEm     DateTime?
  respostaSugerida String?
  sugestaoGeradaEm DateTime?
  avisadaEm        DateTime?
  /// Decisão da equipe de NÃO responder (Caixa de Respostas): sai da fila,
  /// do rascunho automático e do aviso de negativa. `ignoradaPor` é o
  /// User.id INTERNO (nunca clerkId), nulo quando não resolvido — auditoria
  /// nunca bloqueia o gesto.
  ignoradaEm       DateTime?
  ignoradaPor      String?
  /// Resposta APROVADA pela equipe na Caixa, aguardando publicação por uma
  /// sessão do Claude via conector Windsor (não há caminho server-side para
  /// a ação do Google — medido em 30/08/2026). Fila lida por
  /// scripts/respostas-salvas.ts. `respostaAprovadaPor` = User.id INTERNO.
  respostaAprovada    String?
  respostaAprovadaEm  DateTime?
  respostaAprovadaPor String?
  capturedAt       DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([criadaEm])
  @@index([estrelas])
  @@index([projectId, respondidaEm])
}

/// Comentário de Instagram que a equipe decidiu NÃO responder (Caixa de
/// Respostas). Comentários não são persistidos (vêm ao vivo do Windsor);
/// esta tabela guarda só a decisão. `projectId` é Int solto, sem FK —
/// precedente LearningSignal: apagar o projeto não apaga o registro do que
