  @@index([updatedAt(sort: Desc)])
  @@index([isClientProject])
}

/// DNA da marca — identidade que entra INCONDICIONALMENTE em todo prompt de
/// geração (copy e arte). Difere da base de conhecimento, que é buscada por
/// relevância (minScore/topK/teto de tokens) e por isso não serve para
/// identidade: TOM_DE_VOZ na base nunca chegava ao gerador de copy da UI.
///
/// Uma coluna TEXT por seção DE PROPÓSITO (nada de Json): a UI edita por
/// seção, cada gerador consome um recorte diferente (copy usa tom+regras;
/// arte usa estilo+foto+composição), e `brandVisualElements` já mostrou o que
/// acontece com Json sem dono — 4 features fazendo merge manual e metade das
/// chaves nunca lida.
model BrandDNA {
  id                Int      @id @default(autoincrement())
  projectId         Int      @unique
  /// Como a marca fala (copy, chat) — não entra no prompt de imagem
  toneOfVoice       String?
  /// O que nunca fazer/dizer — entra em copy E arte
  contentRules      String?
  /// Layout, hierarquia, respiro — complementa as FontCombinations
  composition       String?
  /// Estética geral; tem prioridade sobre o legado Project.brandStyleDescription
  visualStyle       String?
  /// Luz, enquadramento, tratamento fotográfico
  photoDirection    String?
  /// Crivo de aprovação: perguntas binárias, UMA POR LINHA, na redação do DNA
  /// do cliente. É semântica de REVISÃO (checklist antes de agendar), não de
  /// geração — por isso mora fora de `contentRules`, que é injetado verbatim
  /// no prompt de imagem. A polaridade é MISTA (há pergunta que reprova no
  /// "sim" e pergunta que reprova no "não"): quem lê é gente, não o modelo.
  approvalChecklist String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Anchor sheet do projeto: fotos-âncora canônicas por tipo de cena, usadas
/// pela geração de arte por IA ("a âncora manda, o prompt só descreve a
/// ação"). A trilha `imagem` injeta a âncora de ambiente automaticamente
/// quando a cena é gerada e nenhuma foi escolhida.
model ProjectAnchorImage {
  id          String   @id @default(cuid())
  projectId   Int
  /// Tipo de cena normalizado em kebab-case: "ambiente", "mesa", "balcao",
  /// "chopp"… A tag "ambiente" é a que a injeção automática procura primeiro.
  sceneTag    String
  /// Cópia permanente no Blob (nunca thumbnailLink do Drive — expira).
  blobUrl     String
  /// Origem no Drive, quando veio de lá (para reabrir/reprocessar).
  driveFileId String?
  label       String?
  createdAt   DateTime @default(now())
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sceneTag])
}

/// Pilar de conteúdo: a taxonomia FECHADA de temas de UM cliente (F2).
///
/// Existe porque tema em texto livre não deduplica: "happy hour" e "drinks"
/// viram baldes diferentes e a semana sai com o mesmo assunto duas vezes. A
/// lista é proposta por um passe de LLM sobre o histórico do próprio cliente e
/// **aprovada por gente** na aba Marca; o classificador fica constrangido a
/// ela mais os dois slugs reservados (`outro`, `sem-texto`).
///
/// Por que tabela e não Json no BrandDNA: o slug é chave de junção
/// (`SocialPost.pilar`), a lista é ordenada e editada item a item, e a
/// aprovação é por linha. Json obrigaria a reescrever o conjunto inteiro a
/// cada edição e deixaria a contagem por pilar sem índice — a mesma armadilha
/// de `fieldValues` que os espelhos colunares da F1 vieram corrigir.
model ContentPillar {
  id          String    @id @default(cuid())
  projectId   Int
  /// kebab-case, ESTÁVEL: é o que fica gravado em `SocialPost.pilar`. Renomear
  /// o slug órfã a classificação já feita — mude `nome`, não o slug.
  slug        String
  nome        String
  descricao   String?
  /// Palavras que aparecem quando o assunto é este. Entram no prompt do
  /// classificador e ajudam quem lê a lista a entender o balde.
  exemplos    String[]  @default([])
  ordem       Int       @default(0)
  /// Só pilar APROVADO entra na taxonomia do classificador. A proposta do LLM
  /// nasce `false` e fica visível na aba Marca esperando o olho humano.
  aprovado    Boolean   @default(false)
  aprovadoEm  DateTime?
  /// `User.id` INTERNO (cuid), NUNCA o clerkId.
  aprovadoPor String?
  /// 'llm' (proposto pelo passe) | 'humano' (escrito na mão).
  origem      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId, aprovado])
}

