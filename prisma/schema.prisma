generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations NÃO podem passar pelo pooler do Neon. O `prisma migrate` usa um
  // advisory lock de sessão, e o PgBouncer (modo transação) deixa esse lock
  // preso num backend reaproveitado — a migration seguinte pega outra conexão,
  // não consegue o lock e morre em "Timed out trying to acquire a postgres
  // advisory lock". Aconteceu em produção em 28/07/2026.
  // DIRECT_URL é a mesma URL do banco sem o sufixo `-pooler` no host.
  directUrl = env("DIRECT_URL")
}

model AdminSettings {
  id           String   @id @default("singleton")
  featureCosts Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CreditBalance {
  id               String         @id @default(cuid())
  userId           String         @unique
  clerkUserId      String         @unique
  creditsRemaining Int            @default(100)
  lastSyncedAt     DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  User             User           @relation(fields: [userId], references: [id])
  UsageHistory     UsageHistory[]

  @@index([clerkUserId])
  @@index([creditsRemaining])
  @@index([lastSyncedAt])
  @@index([userId])
}

model CustomFont {
  id         Int      @id @default(autoincrement())
  name       String
  fontFamily String
  fileUrl    String
  projectId  Int
  uploadedBy String
  createdAt  DateTime @default(now())
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Combinação tipográfica de um projeto (título + corpo + detalhes).
/// Os seis modelos base são semeados por projeto no primeiro acesso, para que
/// cada marca ajuste o seu sem afetar as outras.
model FontCombination {
  id        String   @id @default(cuid())
  projectId Int
  name      String
  /// Ordem de exibição na galeria
  order     Int      @default(0)
  /// FontComboElement[]: papel, texto, tipografia, cor, efeitos e posição
  /// relativa ao canvas (0..1), para sobreviver a formatos diferentes
  elements  Json
  /// Veio do catálogo base (não foi criada pelo usuário)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Element {
  id         Int      @id @default(autoincrement())
  name       String
  fileUrl    String
  category   String?
  projectId  Int
  uploadedBy String
  createdAt  DateTime @default(now())
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([projectId])
}

model Feature {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

model Generation {
  id                   String              @id @default(cuid())
  status               GenerationStatus    @default(PROCESSING)
  templateId           Int
  fieldValues          Json
  /**
   * Linhagem da melhoria com IA: aponta para a Generation que foi melhorada.
   * Coluna solta de propósito (sem FK) — a origem pode ser apagada sem
   * arrastar a melhoria junto. O fieldValues.originalGenerationId continua
   * sendo gravado por compatibilidade.
   */
  sourceGenerationId   String?
  /**
   * Carrossel: agrupa os slides de uma mesma peça. Coluna solta, como a
   * linhagem acima — apagar um slide não pode arrastar os irmãos, e o grupo
   * nasce no primeiro slide sem uma entidade "carrossel" para apontar.
   */
  carouselGroupId      String?
  /**
   * Posição do slide (1 = capa). Null em arte avulsa.
   */
  slideOrder           Int?
  /**
   * Marcada como REFERÊNCIA DE ESTILO da marca ("gostei desta"). Null = não é.
   * A geração manda UMA delas como ref de papel `style`.
   */
  styleRefAt           DateTime?
  /**
   * Última vez que foi enviada numa geração. Null = nunca usada, e por isso
   * vem primeiro no rodízio — é o que evita toda peça sair parecida com a
   * mesma referência.
   */
  styleRefUsedAt       DateTime?
  /**
   * Página-modelo que originou esta arte. Espelho colunar de
   * `fieldValues.sourcePageId` — que é Json SEM índice, e por isso minerar
   * "qual modelo este cliente mais usa" hoje exige varredura por path.
   * Coluna solta (sem FK), como a linhagem acima: apagar a página não pode
   * arrastar a arte que já existe.
   */
  sourcePageId         String?
  resultUrl            String?
  projectId            Int
  authorName           String?
  templateName         String?
  projectName          String?
  createdBy            String
  createdAt            DateTime            @default(now())
  completedAt          DateTime?
  googleDriveFileId    String?
  googleDriveBackupUrl String?
  fileName             String?
  Project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Template             Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  socialPosts          SocialPost[]
  VideoProcessingJob   VideoProcessingJob? @relation("GenerationVideoJob")

  @@index([createdAt])
  @@index([createdBy])
  @@index([projectId])
  @@index([sourceGenerationId])
  @@index([sourcePageId])
  @@index([carouselGroupId, slideOrder])
  @@index([projectId, styleRefAt, styleRefUsedAt])
  @@index([status])
  @@index([templateId])
}

/**
 * Fila durável da geração de arte por IA (F0.3).
 * A execução deixou de morar no `after()` da invocação que pediu a arte: uma
 * arte chega a ~290s e o teto da rota é 300s, então uma leva de 5-7 peças (ou
 * um batch JSON-RPC do MCP) estourava o teto e deixava a Generation em
 * PROCESSING para sempre, sem ninguém para recuperá-la.
 * Tabela separada da Generation de propósito: aqui mora COMO o trabalho é
 * executado (payload do runner, tentativas, lease), lá mora O QUE o usuário vê.
 * Sem FK, pelo mesmo precedente de `sourceGenerationId` e `campaignId` — apagar
 * a arte não pode explodir por causa de uma linha de fila.
 */
model GenerationJob {
  id             String              @id @default(cuid())
  /**
   * Generation PROCESSING que este job produz. Único = enfileirar é idempotente.
   */
  generationId   String              @unique
  kind           GenerationJobKind
  status         GenerationJobStatus @default(PENDING)
  /**
   * Argumentos do runner, serializados. É o que permite rodar em OUTRA invocação.
   */
  payload        Json
  projectId      Int
  attempts       Int                 @default(0)
  /**
   * Uma tentativa = uma chamada PAGA do modelo. 2 é o teto que os dois runners já prometiam.
   */
  maxAttempts    Int                 @default(2)
  /**
   * Portão da query de quem varre — nunca aplicado dentro da reserva.
   */
  nextAttemptAt  DateTime            @default(now())
  /**
   * Fim do arrendamento: RUNNING vencido é invocação que morreu.
   */
  leaseExpiresAt DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([projectId])
  @@index([createdAt])
}

/**
 * Sinal de uso (F1) — a unidade do aprendizado por uso.
 * Uma linha = um fato: "isto foi proposto, aquilo foi escolhido". As duas
 * metades convivem na MESMA linha e qualquer uma pode estar vazia:
 * - `sugeridoEm` preenchido e `desfecho` nulo → proposta em aberto;
 * - `sugeridoEm` NULO e `desfecho: 'escolha-propria'` → **escolha absoluta**,
 * a pessoa decidiu sem que nada tivesse sido proposto. Nas primeiras
 * semanas, antes de a dica de copy existir, é o único corpus que haverá.
 * UMA tabela, e não duas (sugestão + desfecho), porque:
 * 1. a decisão SEM sugestão é o caso comum no começo — com duas tabelas ela
 * vira linha de desfecho com FK nula, isto é, o caso especial torto que o
 * desenho tinha de evitar; aqui é uma linha inteira com a metade de cima
 * vazia;
 * 2. a relação é 1:1 por construção — uma leva de 5 slots são 5 propostas,
 * não uma com 5 desfechos;
 * 3. o KPI da F4 (aceitas ÷ emitidas) vira agregação de tabela única, sem
 * LEFT JOIN e sem o cuidado com o lado nulo;
 * 4. a idempotência do desfecho é compare-and-set na própria linha — com duas
 * tabelas seria um UNIQUE em `sugestaoId`, a mesma regra com mais peças.
 * O precedente do `GenerationJob` (tabela separada) NÃO se aplica: lá o que se
 * separou foi COMO o trabalho roda (payload, tentativas, lease) de O QUE o
 * usuário vê — ciclos de vida e frequências de escrita diferentes. Aqui as
 * duas metades são o mesmo fato e são sempre lidas juntas.
 * Nenhum vínculo tem FOREIGN KEY, pelo precedente de
 * `Generation.sourceGenerationId` e `SocialPost.campaignId`: apagar o post, a
 * arte, a página ou a campanha não pode arrastar (nem travar) o registro do
 * que aconteceu.
 */
/// Uso de uma foto do acervo — o que faz a rotação do DNA ("não repetir a mesma
/// foto na semana") deixar de ser decoração.
///
/// Vive no BANCO e não no `usageHistory` do `_image-catalog.json` por duas
/// razões. A primeira é corrida: o catálogo é um JSON único no Drive, e duas
/// gerações simultâneas fariam read-modify-write uma por cima da outra. A
/// segunda é durabilidade — regerar o catálogo zera `usageHistory` (ver
/// `reconciliar-catalogo.ts`), então o histórico morria a cada recatalogação.
/// O catálogo segue sendo lido como legado e as duas fontes são fundidas na
/// ordenação de `buscarNoAcervo`.
model PhotoUsage {
  id           String   @id @default(cuid())
  projectId    Int
  /// Id do arquivo no Drive — a mesma chave que `buscar-fotos` devolve.
  driveFileId  String
  usedAt       DateTime @default(now())
  /// 'arte-ia' | 'arte-rapida' | 'externo' — de onde veio o uso. TEXT pelo
  /// mesmo motivo de `LearningSignal.tipo`: o vocabulário ainda se move.
  origem       String
  /// Tema/assunto da peça, quando conhecido. Ajuda a explicar a repetição.
  tema         String?
  /// Vínculo FROUXO, sem FK: apagar a arte não pode apagar o registro de que a
  /// foto foi usada — mesmo precedente de `Generation.sourceGenerationId`.
  generationId String?

  @@index([projectId, driveFileId])
  @@index([projectId, usedAt])
}

/// Curadoria explícita do acervo — a "prata da casa" (30/08/2026).
///
/// Espelho do padrão dos modelos: foto nasce acervo, destaque é promoção
/// deliberada. No BANCO e não no `_image-catalog.json` pelas duas razões do
/// `PhotoUsage`: corrida de read-modify-write no arquivo único, e regerar o
/// catálogo apagaria a curadoria. Sem FK: apagar a foto do Drive não arrasta
/// o registro. Despromover é `revogadoEm`, nunca DELETE.
model PhotoDestaque {
  id          String    @id @default(cuid())
  projectId   Int
  driveFileId String
  /// 'semente' (script, dos sinais já capturados) | 'humano' (picker/MCP).
  /// TEXT — o vocabulário ainda se move.
  origem      String
  /// User.id INTERNO (nunca clerkId), nullable — auditoria, não gate.
  decididoPor String?
  criadoEm    DateTime  @default(now())
  revogadoEm  DateTime?

  @@unique([projectId, driveFileId])
}

model LearningSignal {
  id           String    @id @default(cuid())
  projectId    Int
  /// 'slot' | 'copy' | 'foto' | 'modelo' — TEXT porque o vocabulário ainda se
  /// move na F2 (mesmo motivo de `SocialPost.origem`). Validação em
  /// `src/lib/aprendizado/vocabulario.ts`.
  tipo         String
  // ── metade SUGESTÃO (nula na escolha absoluta) ──────────────────────────
  /// O que foi proposto. Forma livre por tipo.
  sugerido     Json?
  /// Quando a proposta foi EMITIDA. É o denominador do KPI de aceitação.
  sugeridoEm   DateTime?
  /// Proveniência: qual serviço emitiu ('sugerir-posts', 'prepare-creative'…).
  servico      String?
  /// Versão da heurística/prompt — sem ela não dá para comparar safras.
  versao       String?
  // ── metade DESFECHO (nula enquanto ninguém decidiu) ─────────────────────
  /// 'aceita-como-veio' | 'editada' | 'trocada' | 'descartada' | 'expirada' |
  /// 'escolha-propria' (este último só em linha SEM sugestão).
  desfecho     String?
  /// O que de fato foi escolhido.
  escolhido    Json?
  /// Diff estruturado, quando faz sentido (copy) — ver `diff-copy.ts`.
  diff         Json?
  decididoEm   DateTime?
  /// `User.id` INTERNO (cuid), NUNCA o clerkId.
  decididoPor  String?
  /// 'bancada' | 'chat' | 'editor' | 'agenda' | 'sistema'.
  superficie   String?
  // ── vínculos frouxos, todos sem FK ──────────────────────────────────────
  postId       String?
  generationId String?
  pageId       String?
  campaignId   String?
  /// Chave de idempotência do chamador. Com ela, o mesmo registro gravado
  /// duas vezes (retry de rota, repetição de tool no chat) não duplica.
  chave        String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, tipo, createdAt])
  @@index([projectId, desfecho])
  @@index([desfecho, sugeridoEm])
  @@index([postId])
}

enum GenerationJobKind {
  ARTE
  MELHORIA
}

enum GenerationJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/**
 * Plano de conteúdo (F3) — a LEVA que o chat e a bancada enxergam juntos.
 * A fila da bancada é `localStorage` (`src/stores/bancada-store.ts`, chave
 * `lagosta.bancada`) e nenhuma rota escreve nela: o chat não consegue montar
 * uma semana que a bancada veja, nem o contrário. Esta entidade é o chão comum
 * — a bancada passa a hidratar do servidor e o localStorage vira cache.
 * O que o plano NÃO faz: gerar arte e gastar crédito. Ele registra o que se
 * PRETENDE fazer. Quem executa (e cobra) é `executar-plano`, com gate de
 * confirmação — o contrato da casa é que sugestão nunca agenda nem gasta
 * sozinha.
 * `status` e `origem` são TEXT e não enum do Postgres, pelo precedente da F1
 * (`LearningSignal.tipo`) e por uma razão operacional: `migrate deploy` roda
 * cada migration numa transação, e `ALTER TYPE … ADD VALUE` não pode ser usado
 * no mesmo bloco em que o tipo é criado. Vocabulário que ainda se move fica em
 * TEXT; a validação mora em `src/lib/planos/vocabulario.ts`.
 */
model PlanoDeConteudo {
  id        String   @id @default(cuid())
  /// Sem relação com `Project`, pelo precedente dos dois models mais recentes
  /// (`LearningSignal`, `GenerationJob`).
  projectId Int
  /// "Semana de 17 a 23/08", "Festival Italiano" — o nome que a pessoa lê.
  titulo    String?
  /// A janela que o plano cobre. Item fora dela é AVISO, nunca erro: campanha
  /// prorrogada e prazo velho da base já ensinaram que recusar por metadado é
  /// pior que aceitar com ressalva.
  inicio    DateTime
  fim       DateTime
  /// 'ativo' | 'arquivado'.
  status    String   @default("ativo")
  /// Que superfície montou: 'chat' | 'bancada' | 'propor-semana'.
  origem    String?
  /// Versão da heurística que montou o plano — sem ela não dá para comparar
  /// safras (mesmo motivo de `LearningSignal.versao`).
  versao    String?
  /// `User.id` INTERNO (cuid), NUNCA o clerkId.
  criadoPor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens ItemDePlano[]

  /// A leitura quente é "o plano ativo deste cliente, o mais recente primeiro"
  /// (`planoAtivo`) e a lista filtrada por situação (`listarPlanos`). O mesmo
  /// índice serve às duas.
  @@index([projectId, status, createdAt])
}

/**
 * Um post PRETENDIDO dentro de um plano (F3).
 * 🔴 A regra de FK aqui tem duas metades, e a distinção importa:
 * - `planoId` **TEM** FK, com `onDelete: Cascade`. É parentesco estrito: item
 * sem plano não significa nada. A regra "sem FK" da casa é sobre vínculo
 * FROUXO com entidade apagável, não sobre o dono da linha.
 * - `postId`, `generationId`, `pageId`, `campaignId`, `sugestaoId` e
 * `sourcePageId` **não têm FK nenhuma**, pelo precedente de
 * `Generation.sourceGenerationId` e `SocialPost.campaignId`: apagar o post,
 * a arte, a página ou a campanha não pode arrastar nem travar o registro do
 * que se pretendia fazer.
 */
model ItemDePlano {
  id        String @id @default(cuid())
  planoId   String
  /// Redundante com `plano.projectId` de propósito: toda leitura/escrita do
  /// serviço filtra por projeto (item de outro cliente é 404, nunca 403 com
  /// vazamento), e sem a coluna isso viraria join em todo caminho.
  projectId Int
  ordem     Int    @default(0)

  /// Quando publicar, em UTC. Nulo enquanto o horário não foi decidido.
  quando       DateTime?
  tema         String?
  /// Blocos de texto, como a copy da bancada (headline, apoio, CTA).
  copyProposta String[]  @default([])
  legenda      String?
  fotoUrl      String?
  fotoDriveId  String?
  /// 'story' | 'feed' | 'quadrado'.
  formato      String
  /// 'template' (padrão — custo de API de imagem ZERO) | 'ia'. A escolha de
  /// via também é sinal aprendido.
  via          String    @default("template")
  /// A página-modelo escolhida na via template.
  sourcePageId String?
  /// Direção adicional para a geração por IA (o `pedido` do serviço de arte):
  /// o que dizer ao modelo além do tema — "trate o print como mockup de
  /// celular", "a foto é a cena, o texto fica na coluna livre". Nasceu em
  /// 23/08/2026: até então o campo da bancada ficava só no navegador e o
  /// executar-plano mandava o NOME DO TEMA como pedido.
  direcao      String?
  /// Ajuste autorizado na FOTO, só desta peça (`instrucaoImagem`): sem ele a
  /// foto vai intocada, que é o padrão da casa.
  ajusteDaFoto String?
  /// Referências de imagem com papel (`[{ role, driveFileId?, url?, label? }]`),
  /// as mesmas que `startArtGeneration` recebe. Nulo = só a foto espelho
  /// (`fotoUrl`/`fotoDriveId`), que continua existindo como capa do card e
  /// como compatibilidade com itens anteriores a 23/08/2026. Quando a lista
  /// existe, ela VENCE e o espelho é derivado dela (a cena).
  referencias Json?
  /// Top-3 candidatas de foto da emissão (plano de fotos, 30/08/2026):
  /// `[{ driveFileId, fileName?, vaga: 'score' | 'exploracao', sugestaoId? }]`.
  /// Payload do card — a verdade do que foi OFERECIDO mora no LearningSignal.
  fotoCandidatas Json?
  /// Co-branding: o cliente CITADO na peça (projeto do Studio), cuja logomarca
  /// oficial é composta na arte. É como a Lagosta Criativa mostra o trabalho
  /// feito para um cliente sem esconder de quem é. Sem FK, como `campaignId`.
  clienteProjectId Int?
  /// Por que este horário — a frase que a proposta mostra para quem lê.
  motivoDoSlot String?

  /// O que o sistema pode aprender com este post, quando ele existir.
  escopo     LearningScope @default(ROTINA)
  campaignId String?

  /// 'proposto' | 'editado' | 'aprovado' | 'reprovado' | 'na-fila' |
  /// 'gerando' | 'pronto' | 'erro' | 'agendado'. Ver
  /// `src/lib/planos/vocabulario.ts`.
  status           String  @default("proposto")
  /// Por que foi reprovado — é o que transforma a recusa em sinal, em vez de
  /// beco sem saída.
  motivoReprovacao String?
  /// Falha da geração, em português.
  erro             String?

  /// Carrossel: os slides da série, como Json — `{ groupId, lista: [...] }`,
  /// cada slide com ordem, copy, foto e (conforme avança) generationId e
  /// resultUrl. Json e não tabela-filha porque a leva é lida e escrita SEMPRE
  /// inteira (ninguém consulta "todos os slides 3 do projeto"), e o precedente
  /// de dado posicional editado em bloco é `Page.layers`. Nulo = peça única.
  slides Json?

  /// Preenchidos conforme o item avança: a arte, a página e o post que ele
  /// virou. Sem FK (ver o cabeçalho).
  generationId String?
  pageId       String?
  postId       String?
  /// O `LearningSignal` da sugestão de horário que originou este item.
  sugestaoId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plano PlanoDeConteudo @relation(fields: [planoId], references: [id], onDelete: Cascade)

  /// Os itens deste plano, na ordem em que a leva foi montada — a leitura de
  /// toda tela e de toda tool que mostra o plano.
  @@index([planoId, ordem])
  /// "O que ainda está por fazer neste cliente": a varredura por situação que
  /// a execução e a hidratação da bancada consultam.
  @@index([projectId, status])
}

model Logo {
  id            Int      @id @default(autoincrement())
  name          String
  fileUrl       String
  projectId     Int
  uploadedBy    String
  createdAt     DateTime @default(now())
  isProjectLogo Boolean  @default(false)
  Project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, isProjectLogo])
}

model BrandColor {
  id         Int      @id @default(autoincrement())
  name       String
  hexCode    String
  projectId  Int
  uploadedBy String
  createdAt  DateTime @default(now())
  Project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Plan {
  id                 String   @id @default(cuid())
  clerkId            String?  @unique
  clerkName          String?
  name               String
  credits            Int
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  currency           String?
  priceMonthlyCents  Int?
  priceYearlyCents   Int?
  badge              String?
  ctaLabel           String?
  ctaType            String?  @default("checkout")
  ctaUrl             String?
  description        String?
  features           Json?
  highlight          Boolean  @default(false)
  billingSource      String   @default("clerk")
  sortOrder          Int      @default(0)
  allowOrgCreation   Boolean  @default(false)
  orgMemberLimit     Int?
  orgProjectLimit    Int?
  orgCreditsPerMonth Int?
  orgCountLimit      Int?

  @@index([active])
}

model Project {
  id                          Int                     @id @default(autoincrement())
  name                        String
  description                 String?
  status                      ProjectStatus           @default(ACTIVE)
  logoUrl                     String?
  /// Manual de identidade feito por DESIGNER (upload). Tem prioridade absoluta
  /// sobre o Brand Reference Card auto-gerado: no insta-automatico, onde a
  /// prática nasceu, o manual "funciona MUITO melhor" como referência visual.
  brandManualUrl              String?
  googleDriveFolderId         String?
  makeWebhookAnalyzeUrl       String?
  makeWebhookCreativeUrl      String?
  userId                      String
  workspaceId                 Int?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  googleDriveFolderName       String?
  googleDriveImagesFolderId   String?
  googleDriveImagesFolderName String?
  googleDriveVideosFolderId   String?
  googleDriveVideosFolderName String?
  instagramAccountId          String?
  instagramUsername           String?
  zapierWebhookUrl            String?
  isClientProject             Boolean                 @default(false)
  instagramUserId             String?
  /// Token do Instagram Login (IGAA...), válido só para esta conta.
  /// Quando presente, tem precedência sobre INSTAGRAM_ACCESS_TOKEN e as
  /// chamadas usam /me/... em graph.instagram.com — o id da conta não é usado.
  instagramAccessToken        String?
  /// Expira em 60 dias; o cron de refresh renova antes disso
  instagramTokenExpiresAt     DateTime?
  /// Id com escopo de app, devolvido por /me (diferente de instagramUserId)
  instagramAppScopedId        String?
  aiChatBehavior              String?
  /// Direção de arte da melhoria com IA. Nulo = usa DEFAULT_ART_DIRECTION
  /// (src/lib/ai/openai-image-client.ts). Serve para apertar as regras num
  /// projeto específico sem endurecer o padrão de todos.
  artImprovementPrompt        String?
  /// Autocorreção geométrica de texto pré-render (text-autofix). Desligar
  /// aqui vale para todas as artes do projeto.
  textAutofixEnabled          Boolean                 @default(true)
  /// Curadoria da prancha tipográfica (type-specimen): quando preenchido, a
  /// prancha mostra exatamente estas famílias, nesta ordem, em vez da
  /// heurística — CustomFont existir não significa que a marca a usa.
  specimenFontFamilies        String[]                @default([])
  chatUploads                 ChatUpload[]
  brandDNA                    BrandDNA?
  anchorImages                ProjectAnchorImage[]
  contentPillars              ContentPillar[]
  laterAccountId              String?
  laterProfileId              String?
  postingProvider             PostingProvider?        @default(ZAPIER)
  brandStyleDescription       String?
  brandVisualElements         Json?
  brandReferenceUrls          String[]                @default([])
  cuisineType                 String?
  titleFontFamily             String?
  bodyFontFamily              String?
  /// Fonte de subtítulo. Nulo = a marca usa a do corpo também no subtítulo.
  subtitleFontFamily          String?
  AIGeneratedImage            AIGeneratedImage[]
  BrandColor                  BrandColor[]
  chatConversations           ChatConversation[]
  clientInvite                ClientInvite?
  CustomFont                  CustomFont[]
  Element                     Element[]
  Generation                  Generation[]
  instagramDailySummary       InstagramDailySummary[]
  fontCombinations            FontCombination[]
  instagramFeeds              InstagramFeed[]
  instagramGoalSettings       InstagramGoalSettings?
  instagramStories            InstagramStory[]
  instagramWeeklyReports      InstagramWeeklyReport[]
