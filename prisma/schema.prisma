/// O que o sistema pode aprender com este post.
///
/// ROTINA forma a cadência e o repertório do cliente; CAMPANHA vale para a
/// próxima edição daquela campanha, não para a rotina; PONTUAL não ensina
/// nada (evento único, aviso de feriado). A captura é SEMPRE — o que este
/// campo faz é filtrar na AGREGAÇÃO.
enum LearningScope {
  ROTINA
  CAMPANHA
  PONTUAL
}

/// Cliente OAuth registrado dinamicamente (RFC 7591) por um conector MCP —
/// é assim que o claude.ai se apresenta antes do primeiro login.
model McpOAuthClient {
  id           String          @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime        @default(now())
  codes        McpOAuthCode[]
  tokens       McpOAuthToken[]
}

/// Código de autorização (curta duração, uso único) com o desafio PKCE.
model McpOAuthCode {
  code          String         @id
  clientId      String
  /// Clerk userId de quem aprovou
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String?
  /// Resource (RFC 8707) pedido na autorização, já normalizado — vira a
  /// audiência do token emitido na troca.
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())
  client        McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

/// Token de acesso e refresh. Guardamos só o hash — o valor em claro só
/// existe na resposta ao cliente.
model McpOAuthToken {
  id          String         @id @default(cuid())
  tokenHash   String         @unique
  refreshHash String?        @unique
  clientId    String
  userId      String
  scope       String?
  /// Audiência (RFC 8707): o endpoint /api/mcp para o qual o token foi
  /// emitido. NULA em token anterior à migração — ele continua valendo e
  /// ganha audiência na rotação; a recusa só vale quando preenchida e
  /// divergente.
  audience    String?
  expiresAt   DateTime
  /// Vencimento do REFRESH token (30 dias, renovados a cada rotação). NULO em
  /// token anterior à migração — vale até a próxima rotação, que carimba.
  refreshExpiresAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime       @default(now())
  client      McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

/// Foto enviada pelo celular via link de um toque (tool pedir-foto do
/// conector). O token É o id — cuid não-adivinhável, com validade curta.
model ChatUpload {
  id        String   @id @default(cuid())
